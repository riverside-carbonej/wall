rules_version = '2';

// Firebase Storage security rules for Riverside Wall App.
// Photos follow the wall's own permissions in Firestore: anyone signed in can
// read them (the kiosk loads them by download URL, which these rules don't
// gate), and only people who can edit the wall can add, replace or remove them.
service firebase.storage {
  match /b/{bucket}/o {
    match /walls/{wallId}/items/{itemId}/{allPaths=**} {
      allow read: if request.auth != null;

      allow create, update: if canEditWall(wallId)
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)')
        && request.resource.size < 10 * 1024 * 1024; // 10MB limit

      allow delete: if canEditWall(wallId);
    }

    // The same people Firestore lets edit a wall's items: owner, managers, editors.
    function canEditWall(wallId) {
      let permissions = firestore.get(/databases/(default)/documents/walls/$(wallId)).data.permissions;
      return request.auth != null && (
        permissions.owner == request.auth.uid ||
        request.auth.uid in permissions.get('managers', []) ||
        request.auth.uid in permissions.get('editors', [])
      );
    }

    // Default deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
